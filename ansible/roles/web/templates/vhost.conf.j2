<VirtualHost *:80>
    ServerName {{ vhost_name }}
    DocumentRoot {{ app_dir }}

    <Directory {{ app_dir }}>
        AllowOverride All
        Require all granted
    </Directory>

    <DirectoryMatch "/\.git">
        Require all denied
    </DirectoryMatch>

    ErrorLog ${APACHE_LOG_DIR}/{{ vhost_name }}_error.log
    CustomLog ${APACHE_LOG_DIR}/{{ vhost_name }}_access.log combined
</VirtualHost>
